# Deterministic replay mode works without secrets.
RESEARCH_AGENT_MODE=fixture
DATABASE_URL=sqlite:///data/research_agent.db
LOG_PATH=data/events.jsonl
LEASE_SECONDS=30
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=0.2
REQUEST_TIMEOUT_SECONDS=15
MAX_SOURCE_CHARS=40000

# Live mode uses an OpenAI-compatible Chat Completions endpoint.
# RESEARCH_AGENT_MODE=live
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=replace-me
# LLM_MODEL=provider-model-name

